APP_NAME=TransitGo Backend
APP_ENV=development

HOST=0.0.0.0
PORT=8000

REDIS_URL=redis://localhost:6379/0

SQLITE_PATH=./data/transitgo.db

REQUEST_TIMEOUT=30

